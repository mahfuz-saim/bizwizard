# Backend API base URL (the /api/v1 prefix used by the Express server)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1

# Demo credentials used for silent login (no login UI shown yet).
# Must match DEMO_EMAIL / DEMO_PASSWORD in the server's .env
NEXT_PUBLIC_DEMO_EMAIL=owner@demo.local
NEXT_PUBLIC_DEMO_PASSWORD=demo1234
