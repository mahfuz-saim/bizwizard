model ReferralCode {
  id                    String                @id @default(uuid())
  code                  String                @unique
  userType              ReferralCodeOwnerType
  ownerId               String?               @unique
  Owner                 Owner?                @relation(fields: [ownerId], references: [userID])
  salesRepresentativeId String?               @unique
  salesRepresentative   SalesRepresentative?  @relation(fields: [salesRepresentativeId], references: [userID])
  Referrals             Referral[]

  @@map("referral_code")
}

model Referral {
  id                            String               @id @default(uuid())
  // The referral code that was used
  referralCodeId                String
  referralCode                  ReferralCode         @relation(fields: [referralCodeId], references: [id])
  // The user who was referred (owner today; SR for SR->SR chains)
  referredUser                  Owner?               @relation("userRef")
  // optional SR-side referred user (for SR->SR chains)
  referredSalesRepresentativeId String?
  referredSalesRepresentative   SalesRepresentative? @relation("srReferred", fields: [referredSalesRepresentativeId], references: [userID])
  // all reward rows tied to this Referral via the now-non-unique referralId
  rewards                       ReferralReward[]     @relation("ReferralMainReward")
  // chain-bonus reward row (one-to-one, alternate inverse on chainBonusReferralId)
  chainBonusReward              ReferralReward?      @relation("ChainBonusReferral")

  @@index([referralCodeId])
  @@index([referredSalesRepresentativeId])
  @@map("referrals")
}

model ReferralReward {
  id                   String    @id @default(uuid())
  // referralId is now nullable + non-unique — chain-bonus reward rows are not tied to a Referral.
  // (the unique index is intentionally dropped so the chain-bonus row can also reference
  //  the same Referral.id via chainBonusReferralId below.)
  referralId           String?
  // alternate unique key used by chain-bonus reward rows so both can coexist
  chainBonusReferralId String?   @unique
  chainBonusReferral   Referral? @relation("ChainBonusReferral", fields: [chainBonusReferralId], references: [id])

  // Referrer (person who shared the code) rewards
  referrerStatus     RewardClaimStatus    @default(PENDING)
  referrerRewardType RewardType?
  referrerCredits    Float?               @default(100)
  referrerSubDays    Int?                 @default(7)
  referrerClaimedAt  DateTime?
  referrerShopId     String?
  referrerShop       Shop?                @relation("ReferrerRewards", fields: [referrerShopId], references: [id])
  referrerTenantId   String?
  referrerTenant     Tenant?              @relation("ReferrerRewards", fields: [referrerTenantId], references: [id])
  referrerSalesRepId String?
  referrerSalesRep   SalesRepresentative? @relation("RewardReferrerSR", fields: [referrerSalesRepId], references: [userID])

  // Referred user (new user who signed up) rewards
  referredStatus     RewardClaimStatus    @default(PENDING)
  referredRewardType RewardType?
  referredCredits    Float?               @default(100)
  referredSubDays    Int?                 @default(7)
  referredClaimedAt  DateTime?
  referredShopId     String?
  referredShop       Shop?                @relation("ReferredRewards", fields: [referredShopId], references: [id])
  referredTenantId   String?
  referredTenant     Tenant?              @relation("ReferredRewards", fields: [referredTenantId], references: [id])
  referredSalesRepId String?
  referredSalesRep   SalesRepresentative? @relation("RewardReferredSR", fields: [referredSalesRepId], references: [userID])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  Referral  Referral? @relation("ReferralMainReward", fields: [referralId], references: [id])

  @@index([referrerTenantId, id])
  @@index([referredTenantId, id])
  @@index([referrerShopId])
  @@index([referredShopId])
  @@index([referrerStatus])
  @@index([referredStatus])
  @@index([referrerSalesRepId])
  @@index([referredSalesRepId])
  @@map("referral_rewards")
}

