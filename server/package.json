{
    "name": "bebsapati-backend",
    "version": "1.0.0",
    "main": "src/server.ts",
    "license": "MIT",
    "scripts": {
        "dev": "nodemon --watch src --exec bun run src/server.ts",
        "prod": "node dist/server.js",
        "build": "tsc",
        "lint:check": "eslint --ignore-path .eslintignore --ext .js,.ts .",
        "lint:fix": "eslint . --fix",
        "prettier:check": "prettier --ignore-path .gitignore --write \"**/*.+(js|ts|json)\"",
        "prettier:fix": "prettier --write .",
        "lint-prettier": "yarn lint:check && yarn prettier:check",
        "prisma:migrate": "npx prisma migrate dev ",
        "prisma:generate": "npx prisma generate",
        "test": "echo \"Error: no test specified\" && exit 1",
        "seed": "prisma generate && ts-node --project prisma/tsconfig.json prisma/seed.ts",
        "seed:test": "prisma generate && ts-node --project prisma/tsconfig.json prisma/seed/transaction-data.test.ts",
        "pris": "npx prisma migrate dev && npx prisma generate"
    },
    "dependencies": {
        "@prisma/client": "^6.3.1",
        "@types/node": "^20.10.4",
        "@types/node-schedule": "^2.1.7",
        "axios": "^1.8.4",
        "bcrypt": "^5.1.1",
        "bcryptjs": "^3.0.3",
        "cloudinary": "^2.8.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "date-fns": "^3.2.0",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "firebase-admin": "^13.8.0",
        "googleapis": "^170.0.0",
        "http-status": "^1.7.3",
        "jsonwebtoken": "^9.0.2",
        "jwt-decode": "^4.0.0",
        "multer": "^1.4.5-lts.1",
        "nanoid": "3",
        "node-cron": "^3.0.3",
        "node-schedule": "^2.1.1",
        "open": "^11.0.0",
        "sslcommerz-lts": "^1.2.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.3.3",
        "uuid": "^9.0.1",
        "winston": "^3.11.0",
        "winston-daily-rotate-file": "^4.7.1",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@types/bcrypt": "^5.0.2",
        "@types/cookie-parser": "^1.4.6",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.8",
        "@types/multer": "^1.4.11",
        "@types/node-cron": "^3.0.11",
        "@types/nodemailer": "^6.4.14",
        "@types/uuid": "^9.0.7",
        "@typescript-eslint/eslint-plugin": "^6.13.2",
        "@typescript-eslint/parser": "^6.13.2",
        "eslint": "^8.55.0",
        "lint-staged": "^15.2.0",
        "nodemon": "^3.1.11",
        "prettier": "^3.1.1",
        "prisma": "^6.3.1",
        "ts-node-dev": "^2.0.0"
    },
    "prisma": {
        "seed": "ts-node --project prisma/tsconfig.json prisma/seed.ts"
    }
}
