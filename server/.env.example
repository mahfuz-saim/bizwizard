DEMO_PASSWORD=
DEMO_NUMBER=00000000000
DEMO_SHOP_NAME=Demo Store


# --- SME Finance Copilot (optional; product works deterministically without a key) ---
# Without OPENAI_API_KEY every AI step uses the deterministic core and is
# still schema-validated, guard-checked and logged as model=deterministic-fallback.
OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_REASONING=gpt-4.1
OPENAI_MODEL_EMBEDDING=text-embedding-3-small
AI_PLAN_BUDGET_USD=2.00
AI_FEATURE_FLAGS=matching,cashflow,analysis,agents
