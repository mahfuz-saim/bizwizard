# ---------------------------------------------------------------------------
# BizWizard API environment
#
# Copy this file to `.env` for development (NODE_ENV != production) or to
# `.env.prod` for production. The server loads exactly one of those files.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=5000

# PostgreSQL connection string used by Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bizwizard?schema=public

# JWT auth
JWT_SECRET=
EXPIRES_IN=1d
REFRESH_SECRET=
REFRESH_EXPIRES_IN=7d

# Cloudinary (product images / KYC uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
# `demo` records the purchase and applies the plan/credit immediately.
# There is no external gateway; any other value makes /shop/payment/init
# return HTTP 503.
PAYMENT_MODE=demo

# ---------------------------------------------------------------------------
# Admin alert emails
# ---------------------------------------------------------------------------
# Comma-separated recipients, e.g. "ops@example.com,owner@example.com"
ALERT_RECIPIENT_EMAILS=

# REQUIRED at startup: Gmail OAuth client + token JSON files used by
# src/helpers/sendEmail.ts. They are not committed to git. Create them under
# ./secrets/ (ignored) or point these variables anywhere readable.
GMAIL_APPLICATION_CREDENTIALS=./secrets/gcp-oauth.keys.json
GMAIL_APPLICATION_TOKEN=./secrets/gmail-token.json

# Firebase Cloud Messaging (mobile push). Optional at startup: when unset,
# the server still boots, but FCM send calls fail. Use a service-account JSON.
GOOGLE_APPLICATION_CREDENTIALS=

# ---------------------------------------------------------------------------
# Real-time notification webhook
# ---------------------------------------------------------------------------
# Bearer secret for POST /api/v1/notifications/webhook. Use a long random
# value. When unset, the webhook responds 503 and is disabled.
NOTIFICATION_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Demo owner auto-seed (development convenience)
# ---------------------------------------------------------------------------
# When DEMO_EMAIL and DEMO_PASSWORD are set, the server ensures this OWNER
# account + tenant + shop exist at startup.
DEMO_EMAIL=
DEMO_PASSWORD=
DEMO_NUMBER=00000000000
DEMO_SHOP_NAME=Demo Store

# ---------------------------------------------------------------------------
# SME Finance Copilot (optional)
# ---------------------------------------------------------------------------
# Without OPENAI_API_KEY every AI step uses the deterministic core and is
# still schema-validated, guard-checked and logged as
# model=deterministic-fallback.
OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_REASONING=gpt-4.1
OPENAI_MODEL_EMBEDDING=text-embedding-3-small
AI_PLAN_BUDGET_USD=2.00
AI_FEATURE_FLAGS=matching,cashflow,analysis,agents
