# Allow updated AndroidManifest.xml (contains widget provider registration)
!android/app/src/main/AndroidManifest.xml
# Allow updated MainActivity.kt (contains deep link handling)
!android/app/src/main/java/com/bebsapati/com/MainActivity.kt
# Allow updated MainApplication.kt (contains widget module registration)
!android/app/src/main/java/com/bebsapati/com/MainApplication.ktd - Ignore everything except widget-related files
