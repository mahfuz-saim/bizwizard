{
	"cli": {
		"version": ">= 16.25.0",
		"appVersionSource": "local"
	},
	"build": {
		"development": {
			"developmentClient": true,
			"distribution": "internal",
			"android": {
				"buildType": "apk"
			},
			"env": {
				"EXPO_PUBLIC_BACKEND": "https://api.bebsapati.com/api/v1",
				"EXPO_PUBLIC_APP_VERSION": "1.2.0"
			}
		},
		"preview": {
			"distribution": "internal",
			"android": {
				"buildType": "apk"
			},
			"env": {
				"EXPO_PUBLIC_BACKEND": "https://api.bebsapati.com/api/v1",
				"EXPO_PUBLIC_APP_VERSION": "1.2.0"
			}
		},
		"production": {
			"android": {
				"buildType": "app-bundle",
				"image": "latest"
			},
			"autoIncrement": true,
			"releaseChannel": "production",
			"env": {
				"EXPO_PUBLIC_BACKEND": "https://api.bebsapati.com/api/v1",
				"EXPO_PUBLIC_APP_VERSION": "1.2.4"
			}
		}
	},
	"submit": {
		"production": {
			"android": {
				"track": "internal"
			}
		}
	}
}
